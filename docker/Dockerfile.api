# QA service: retrieval glue + REST. No model weights, no torch: the LLM / embedder / reranker are separate endpoints.
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
# one source of truth for dependencies: pyproject (core + the `serve` extra)
RUN python - <<'PY' > /tmp/requirements.txt && pip install --no-cache-dir -r /tmp/requirements.txt
import tomllib
p = tomllib.load(open("pyproject.toml", "rb"))["project"]
print("\n".join(p["dependencies"] + p["optional-dependencies"]["serve"]))
PY
COPY src ./src
COPY configs ./configs
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 LAWRAG_EXP=configs/exp/S1_serve.yaml SHOTS_PATH=/app/data/serve/shots.json PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s CMD python -c "import urllib.request,os;urllib.request.urlopen(f'http://localhost:{os.environ[\"PORT\"]}/health',timeout=4)"
CMD ["python", "-m", "serve"]
